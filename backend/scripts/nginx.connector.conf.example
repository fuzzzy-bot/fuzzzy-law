# Fuzzzy Law public connector — nginx site
#
#   Cloudflare (proxied, Full strict)  →  nginx :443  →  127.0.0.1:8050 (docker)
#
# Install as /etc/nginx/sites-available/fuzzzy-law-connector and symlink into
# sites-enabled in place of the old app's `fuzzzy-law` site (same host name;
# only one of the two may be enabled). Run `nginx -t` before every reload.
#
# What a person asks must not be kept. The MCP endpoint carries the question in
# the request body, which nginx never logs; the REST mirror carries it in the
# query string, so the access log writes $uri (the path alone) and the error
# log is set to `crit`, because nginx's ordinary error lines quote the whole
# request line. The caller's address is logged for abuse handling and kept
# seven days (scripts/logrotate.connector.example).
log_format fuzzzy_law_connector '$remote_addr - [$time_local] '
                                '"$request_method $uri $server_protocol" $status '
                                '$body_bytes_sent $request_time';

# An outer guard only: 10 requests a second per address with a short burst.
# The per-minute limit people actually meet is counted inside the connector,
# which knows the AI providers' shared networks.
limit_req_zone $binary_remote_addr zone=fuzzzy_law_connector:10m rate=10r/s;

# Other site files on this server were written expecting the Law site to
# define this name; it moved here together with the host name.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name law-api.fuzzzycore.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name law-api.fuzzzycore.com;

    # Cloudflare Origin CA certificate (trusted by Cloudflare only).
    ssl_certificate     /etc/nginx/ssl/cloudflare-origin.pem;
    ssl_certificate_key /etc/nginx/ssl/cloudflare-origin.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # The caller's real address. CF-Connecting-IP is believed only when the
    # connection comes from Cloudflare (https://www.cloudflare.com/ips/, read
    # 2026-11-14); a request sent straight to this server keeps its own
    # address, so it cannot borrow someone else's request limit.
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;

    access_log /var/log/nginx/fuzzzy-law-connector/access.log fuzzzy_law_connector;
    error_log  /var/log/nginx/fuzzzy-law-connector/error.log crit;

    # A tool call is a small JSON body; the connector itself refuses over 64 KB.
    client_max_body_size 64k;

    limit_req zone=fuzzzy_law_connector burst=40 nodelay;
    limit_req_status 429;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    # Set, never appended: the connector limits by the first address it sees.
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout    30s;
    proxy_send_timeout    30s;

    # The only public paths. Everything else on this host is a 404.
    location = /mcp {
        proxy_pass http://127.0.0.1:8050;
    }
    location /api/v1/connector/ {
        proxy_pass http://127.0.0.1:8050;
    }
    # The public page of what the connector holds.
    location = /coverage {
        proxy_pass http://127.0.0.1:8050;
    }
    location = /healthz {
        proxy_pass http://127.0.0.1:8050;
    }
    location = /healthz/data {
        proxy_pass http://127.0.0.1:8050;
    }
    # The bare address sends a browser to the project website; robots.txt keeps crawlers
    # on /coverage and off the machine endpoints. Both answered by the connector.
    location = / {
        proxy_pass http://127.0.0.1:8050;
    }
    location = /robots.txt {
        proxy_pass http://127.0.0.1:8050;
    }
    location / {
        return 404;
    }
}
